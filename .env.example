CTV_BASE_URL=https://cctv.example.org
CTV_RECORDINGS_PATH=/mnt/kameras
CTV_DATA_PATH=./data
# Standard: nur vom Host-Reverse-Proxy erreichbar.
CTV_BIND_ADDRESS=127.0.0.1
CTV_HTTP_PORT=8080
CTV_VERSION=latest
CTV_UID=10001
CTV_GID=10001

# Im Browser gespeicherte Werte haben Vorrang vor diesen Ausgangswerten.
# Unter Herkunft und Umgebungswerte einzeln zurücksetzen.
# Docker-Pfade und Netzwerk bleiben ausschließlich extern konfiguriert.

# Anmeldung
CTV_LOCAL_ADMIN=true
CTV_SESSION_MINUTES=480
# IP/CIDR des Reverse-Proxys; nie pauschal 0.0.0.0/0 verwenden.
CTV_TRUSTED_PROXIES=

# Optional: ohne Issuer ist nur die lokale Anmeldung verfügbar.
CTV_OIDC_ISSUER=
CTV_OIDC_CLIENT_ID=
# Client-Secret direkt hier eintragen.
CTV_OIDC_CLIENT_SECRET=
CTV_OIDC_GROUP_CLAIM=groups
# Pocket-ID: Nur Mitglieder dieser Gruppe erhalten SSO-Zugang (als Admin).
CTV_OIDC_ALLOWED_GROUPS=
CTV_OIDC_ADMIN_GROUPS=cctv-admin
# Subject-IDs (sub), durch Komma getrennt; keine E-Mail-Adressen.
CTV_OIDC_ALLOWED_SUBJECTS=
CTV_OIDC_ADMIN_SUBJECTS=

# Ressourcen und Indexierung (auch im Browser änderbar)
CTV_MAX_TRANSCODERS=1
CTV_CACHE_MB=512
CTV_SCAN_INTERVAL_SECONDS=300
