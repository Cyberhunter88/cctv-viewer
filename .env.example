# Externe Grundeinstellungen für Docker Compose.
CTV_BASE_URL=https://cctv.example.org
CTV_RECORDINGS_PATH=/mnt/kameras
CTV_DATA_PATH=./data
# Standard: nur vom Host-Reverse-Proxy erreichbar.
CTV_BIND_ADDRESS=127.0.0.1
CTV_HTTP_PORT=8080
CTV_VERSION=latest
CTV_UID=10001
CTV_GID=10001
# IP/CIDR des Reverse-Proxys; nie pauschal 0.0.0.0/0 verwenden.
CTV_TRUSTED_PROXIES=

# Benutzer, Anmeldung/OIDC, Sitzungen und Betrieb in der Web-Verwaltung einrichten.
# Lokale Anmeldung ist anfangs aktiv; den ersten Admin per CLI erstellen (README).
# Optionale Umgebungswerte und bestehende Installationen: docs/CONFIGURATION.md.
# Gespeicherte GUI-Werte haben Vorrang und bleiben im Datenverzeichnis erhalten.
