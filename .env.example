CTV_BASE_URL=https://cctv.example.org
CTV_RECORDINGS_PATH=/mnt/kameras
CTV_DATA_PATH=./data
# Standard: nur vom Host-Reverse-Proxy erreichbar.
CTV_BIND_ADDRESS=127.0.0.1
CTV_HTTP_PORT=8080
CTV_VERSION=latest
CTV_UID=10001
CTV_GID=10001

# Anmeldung
CTV_LOCAL_ADMIN=true
# IP/CIDR des Reverse-Proxys; nie pauschal 0.0.0.0/0 verwenden.
CTV_TRUSTED_PROXIES=

# Optional: ohne Issuer ist nur die lokale Anmeldung verfügbar.
CTV_OIDC_ISSUER=
CTV_OIDC_CLIENT_ID=
# Client-Secret direkt hier eintragen.
CTV_OIDC_CLIENT_SECRET=
CTV_OIDC_GROUP_CLAIM=groups
CTV_OIDC_ALLOWED_GROUPS=cctv-viewers
CTV_OIDC_ADMIN_GROUPS=cctv-admins
# Subject-IDs (sub), durch Komma getrennt; keine E-Mail-Adressen.
CTV_OIDC_ALLOWED_SUBJECTS=
CTV_OIDC_ADMIN_SUBJECTS=

# Ressourcen und Indexierung
CTV_MAX_TRANSCODERS=1
CTV_CACHE_MB=512
CTV_SCAN_INTERVAL_SECONDS=300
