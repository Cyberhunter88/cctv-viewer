{
  "name": "cctv-viewer",
  "private": true,
  "version": "0.12.0",
  "scripts": {
    "build": "esbuild web/src/app.ts --bundle --minify --target=es2022 --format=esm --splitting --outdir=web/dist --entry-names=app --chunk-names=chunks/[name]",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test_frontend.mjs",
    "test:browser": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "hls.js": "1.7.3"
  }
}
