{
  "name": "cctv-viewer",
  "private": true,
  "version": "0.9.6",
  "scripts": {
    "build": "esbuild web/src/app.ts --bundle --minify --target=es2022 --outfile=web/dist/app.js",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test web/src/timeline.test.ts web/src/management.test.ts web/src/view-state.test.ts web/src/preferences.test.ts",
    "test:browser": "playwright test"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "typescript": "5.9.3",
    "@types/node": "24.10.0",
    "@playwright/test": "1.64.1"
  },
  "dependencies": {
    "hls.js": "1.6.15"
  }
}
